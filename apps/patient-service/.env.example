PORT=3002
DATABASE_URL=postgresql://totan:totan_secret@localhost:5433/totan_patient
REDIS_URL=redis://localhost:6379
AUTH_SERVICE_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8000

# URL หน้าเว็บ — ใช้สร้างลิงก์รายงานในเมลที่ส่งถึงผู้ปกครอง
WEB_URL=http://localhost:3100

# URL ของ service นี้ที่ browser/ai-service เข้าถึงได้ — ใช้สร้างลิงก์ไฟล์ local
# (โหมดยังไม่ตั้งค่า Supabase) ถ้ารันคนละเครื่อง/container ต้องเปลี่ยนจาก localhost
PUBLIC_BASE_URL=http://localhost:3002

# ต้องตรงกับ ai-service (ใช้ยืนยัน endpoint ภายใน เช่น ai-result / upload-heatmap)
INTERNAL_SECRET=change_this_to_a_long_random_string

# Supabase Storage (S3-compatible) — ใช้เก็บภาพ X-ray / Heatmap
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_S3_ACCESS_KEY=your-access-key
SUPABASE_S3_SECRET_KEY=your-secret-key
STORAGE_BUCKET_NAME=totan
STORAGE_PUBLIC_URL=https://your-project-ref.supabase.co/storage/v1/object/public/totan
