{
  "name": "@totan/ai-service",
  "version": "1.0.0",
  "scripts": {
    "start:dev": "py -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "start:prod": "py -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2",
    "install:py": "py -m pip install -r requirements.txt"
  }
}
