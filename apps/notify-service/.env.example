PORT=3004
REDIS_URL=redis://localhost:6379

# ใช้ขอ email ผู้ใช้จาก auth-service (internal endpoint)
AUTH_SERVICE_URL=http://localhost:3001
INTERNAL_SECRET=change_this_to_a_long_random_string

# Email — ถ้าไม่ตั้งทั้ง SMTP และ BREVO_API_KEY service จะรันแบบ log-only
# production (Railway บล็อก SMTP): ตั้ง BREVO_API_KEY แล้วส่งผ่าน Brevo HTTP API แทน
# BREVO_API_KEY=xkeysib-...
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=noreply@totan.app

# Firebase (Push Notification) — ยังไม่ใช้
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@email.com
FIREBASE_PRIVATE_KEY=your-private-key
