PORT=3001
DATABASE_URL=postgresql://totan:totan_secret@localhost:5432/totan_auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ต้องตรงกับ patient-service / ai-service / notify-service (ใช้ยืนยัน service-to-service)
INTERNAL_SECRET=change_this_to_a_long_random_string

# Email (SMTP) — ใช้ส่ง OTP ยืนยันอีเมล
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="โตทัน <noreply@totan.app>"

# Supabase Storage (S3-compatible) — ใช้เก็บรูป avatar
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_S3_ACCESS_KEY=your-access-key
SUPABASE_S3_SECRET_KEY=your-secret-key
STORAGE_BUCKET_NAME=totan
STORAGE_PUBLIC_URL=https://your-project-ref.supabase.co/storage/v1/object/public/totan
